# Server-side only — used by api/google-reviews.ts. Never prefix these with VITE_:
# any VITE_-prefixed variable gets inlined into the browser bundle by Vite, which
# would leak the API key. These two are read by the Vercel Edge Function only.

# Google Cloud API key with "Places API (New)" enabled, restricted to that API.
GOOGLE_PLACES_API_KEY=

# The ChIJ...-format Place ID for "Wipely Cleaning Services" — find it via
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=

# Set both of the above in Vercel: Project → Settings → Environment Variables.
# Locally, `npm run dev` (plain Vite) does not serve /api routes at all — use
# `vercel dev` (with a local .env file, gitignored) to test the live fetch,
# or deploy to a Vercel preview. Without these set, the homepage automatically
# falls back to the approved reviews in src/data/googleReviews.ts.

# Client-side (VITE_-prefixed - these ARE inlined into the browser bundle,
# which is fine here since a Pixel ID is public by nature, visible in every
# page's network requests):

# Meta (Facebook) Pixel ID, from Meta Events Manager > Data Sources > your
# Pixel > Settings. Without this set, src/lib/metaPixel.ts no-ops (no script
# is injected, no events fire) so local dev/builds work fine without it.
VITE_META_PIXEL_ID=

# Google Analytics 4 Measurement ID, from GA4 Admin > Data Streams > your
# stream. Optional - src/lib/ga4.ts falls back to the production ID
# (G-BJ0L1QYF32) if this is unset, so local dev/builds work fine without it.
# Set this only if you need to point a build at a different GA4 property.
VITE_GA4_MEASUREMENT_ID=
